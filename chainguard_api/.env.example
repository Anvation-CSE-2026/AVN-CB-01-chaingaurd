# ChainGuard controller (this laptop) — environment template.
#
# This file is a TEMPLATE, not a loaded configuration. The service reads the
# process environment; nothing here loads a .env file automatically. Export the
# values you need before starting uvicorn, for example:
#
#   set -a && . ./chainguard_api/.env && set +a
#   uvicorn chainguard_api.app:app --host 127.0.0.1 --port 8010
#
# Copy to .env (git-ignored) and fill in private values there. NEVER put a real
# token, address or credential in this example file, and never commit .env.
#
# Every variable below already exists in chainguard_api/config.py; this file
# invents no new names. See BRIDGE_CLIENT_CONTRACT.md section 9.

# ---------------------------------------------------------------- local (default)
# These are the values the service already uses. Unchanged local behaviour means
# leaving them unset.

# Directory containing chainguard_mvp/ (default: <workspace>/software supply chain mvp)
#CHAIN_GUARD_ENGINE_ROOT=

# Canonical root scanned repositories must live under (default: <workspace>)
#CHAIN_GUARD_ALLOWED_ROOT=

# Where isolated scan outputs are written (default: <chainguard_api>/scan_workspace)
#CHAIN_GUARD_SCAN_WORKSPACE=

# Bounded worker pool size (default: 2)
#MAX_CONCURRENT_SCANS=

# Per-repository subprocess timeout in seconds (default: 300)
#SCAN_TIMEOUT_SECONDS=

# Interpreter used to run the engine (default: the current interpreter)
#CHAIN_GUARD_PYTHON=

# Pass --no-llm to the scanner (default: true)
#CHAIN_GUARD_NO_LLM=true

# Static dashboard directory served at /ui (default: <workspace>/frontend;
# set to "none" to serve the API without the dashboard)
#CHAIN_GUARD_FRONTEND_DIR=

# ---------------------------------------------------------- remote node (GATED OFF)
# Remote execution stays DISABLED until BOTH the gate below is explicitly true
# AND a node URL is set. While the gate is closed no entry point of this service
# can open a connection to a node, and a scan that asks for execution_mode
# "remote" fails with REMOTE_EXECUTION_DISABLED (503). It is never run locally
# instead — silently substituting a different machine would be a false answer.
#
# Do not open this gate until the node has been verified. Verification is:
#
#   python -m chainguard_api.remote_check --enable --url <node-url>
#   python -m chainguard_api.remote_check --enable --url <node-url> \
#       --token-file ./node.token --allowed-root <node-allowed-root> \
#       --probe-repository <dir-on-the-node>

CHAIN_GUARD_REMOTE_ENABLED=false

# Remote node base URL, e.g. https://<node-host>:8010. Must not embed
# credentials in the URL and must not carry a query string or fragment.
#CHAIN_GUARD_REMOTE_URL=

# Prefer the TOKEN_FILE form: it keeps the secret out of the process environment
# and out of the shell history. Create the file outside this repository.
#CHAIN_GUARD_REMOTE_TOKEN_FILE=
# Only if you cannot use a file:
#CHAIN_GUARD_REMOTE_TOKEN=

# Per-scan round-trip budget to the node, seconds (default: 300)
#CHAIN_GUARD_REMOTE_TIMEOUT_SECONDS=

# Preflight probe budget, seconds (default: 10)
#CHAIN_GUARD_REMOTE_HEALTH_TIMEOUT_SECONDS=

# Remote repository paths must resolve under this prefix, AS THE NODE SEES IT.
# The node applies its own CHAIN_GUARD_ALLOWED_ROOT containment as well.
#CHAIN_GUARD_REMOTE_ALLOWED_ROOT=

# Display name for the node in responses (default: host:port from the URL)
#CHAIN_GUARD_REMOTE_LABEL=

# Default execution mode for a scan that does not choose one: local | remote.
# Leave as local; the dashboard does not send an execution mode at all.
#CHAIN_GUARD_EXECUTION_MODE=local
